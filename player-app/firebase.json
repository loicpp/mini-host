{
  "hosting": {
    "public": "hosted-releases",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/1.1.0/**",
        "destination": "/1.1.0/index.html"
      },
      {
        "source": "**",
        "destination": "/1.1.0/index.html"
      }
    ]
  }
}