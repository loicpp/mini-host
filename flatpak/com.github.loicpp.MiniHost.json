{
    "app-id": "com.github.loicpp.MiniHost",
    "runtime": "org.freedesktop.Platform",
    "runtime-version": "23.08",
    "sdk": "org.freedesktop.Sdk",
    "sdk-extensions": ["org.freedesktop.Sdk.Extension.node20"],
    "command": "minihost-start",
    "finish-args": [
        "--socket=wayland",
        "--socket=fallback-x11",
        "--device=dri",
        "--socket=pulseaudio",
        "--share=network",
        "--talk-name=org.freedesktop.portal.Desktop"
    ],
    "modules": [
        {
            "name": "python-deps",
            "buildsystem": "simple",
            "build-commands": [],
            "modules": [
                "python-deps.json"
            ]
        },
        {
            "name": "animator-ui",
            "buildsystem": "simple",
            "build-options": {
                "append-path": "/usr/lib/sdk/node20/bin",
                "append-ld-library-path": "/usr/lib/sdk/node20/lib"
            },
            "build-commands": [
                "npm install --offline --cache=$PWD/flatpak-node/npm-cache",
                "npm run build",
                "mkdir -p /app/share/minihost/animator-ui/",
                "cp -r dist /app/share/minihost/animator-ui/"
            ],
            "sources": [
                {
                    "type": "dir",
                    "path": "../animator-ui"
                },
                "node-sources.json"
            ]
        },
        {
            "name": "backend",
            "buildsystem": "simple",
            "build-commands": [
                "mkdir -p /app/share/minihost/backend",
                "cp -r backend/* /app/share/minihost/backend/",
                "install -D minihost-start /app/bin/minihost-start",
                "install -D backend/favicon.png /app/share/icons/hicolor/512x512/apps/com.github.loicpp.MiniHost.png",
                "install -D com.github.loicpp.MiniHost.desktop /app/share/applications/com.github.loicpp.MiniHost.desktop"
            ],
            "sources": [
                {
                    "type": "dir",
                    "path": "../backend",
                    "dest": "backend"
                },
                {
                    "type": "file",
                    "path": "minihost-start"
                },
                {
                    "type": "file",
                    "path": "com.github.loicpp.MiniHost.desktop"
                }
            ]
        }
    ]
}
